{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PrenderSoloLaMaquinaDeMLflow",
      "Effect": "Allow",
      "Action": "ec2:StartInstances",
      "Resource": "arn:aws:ec2:us-east-1:CUENTA_AWS:instance/INSTANCIA_ID"
    },
    {
      "Sid": "VerEstadoDeLasInstancias",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus"
      ],
      "Resource": "*"
    }
  ]
}
