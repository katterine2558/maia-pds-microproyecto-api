# Valores concretos de la infraestructura. Copiar a infra/valores.env y llenar.
# infra/valores.env NO se versiona: lleva IPs personales e identificadores de
# la cuenta, y este repositorio es publico.

CUENTA_AWS="000000000000"
REGION="us-east-1"

# IPs publicas del equipo (Katerine, Camilo, Rainer, Leonardo).
# Cada uno la saca con:  curl ifconfig.me
IPS_EQUIPO="1.2.3.4/32 5.6.7.8/32"

# Se llenan solas al correr infra/ec2-mlflow.sh
INSTANCIA=""
IP_MLFLOW=""
SECURITY_GROUP=""

# Destino de las alarmas de presupuesto
CORREO_ALERTAS="tu-correo@ejemplo.com"
