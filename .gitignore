# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Entornos virtuales
.venv/
venv/
env/
.python-version

# Notebooks
.ipynb_checkpoints/

# Datos: los versiona DVC, no Git.
# Se excluye el CONTENIDO (data/**), no la carpeta: si se excluyera la carpeta
# Git no desciende y las excepciones de abajo nunca aplicarian.
data/**
!data/**/
!data/**/*.dvc
!data/**/.gitkeep

# DVC
/.dvc/cache
/.dvc/tmp
/.dvc/config.local

# MLflow (los runs locales no van a Git)
mlruns/
mlartifacts/
mlflow.db

# Modelos empaquetados (artefactos binarios): los versiona DVC
models/**
!models/**/
!models/**/*.dvc
!models/**/.gitkeep

# Artefactos sueltos fuera de models/
*.pkl
*.joblib
*.h5
*.onnx

# Material de referencia del curso (ejemplos de entregas de otros equipos,
# enunciados). No es codigo del proyecto y no se versiona.
examples/

# Configuracion local de asistentes (no se versiona)
CLAUDE.md
.claude/

# Valores concretos de la infraestructura (IPs del equipo, ids de cuenta).
# El repositorio es publico: aqui solo va la plantilla .example
infra/valores.env

# Secretos y configuracion local
.env
.env.*
!.env.example
*.pem
credentials.json

# Logs y temporales
*.log
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# Archivos temporales de Office (Word deja un ~$ al abrir un documento)
~$*

# macOS / OneDrive
.DS_Store
Icon?
._*
.Trashes
